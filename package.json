{
    "name": "book-store",
    "version": "0.8.0",
    "private": true,
    "scripts": {
        "dev": "npx prisma generate; vite dev",
        "build": "npx prisma generate; vite build",
        "build-noenv": "BOOKS_API_KEY='' vite build",
        "preview": "vite preview",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check-noenv": "BOOKS_API_KEY='' svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "data-migration:add-optional-date": "node ./prisma/migrations/20241110174304_add_optional_date/data-migration.js",
        "seed-initial": "tsx prisma/seed-initial.ts"
    },
    "devDependencies": {
        "@sveltejs/adapter-auto": "^7.0.1",
        "@sveltejs/adapter-node": "^5.5.7",
        "@sveltejs/kit": "^2.8.0",
        "@sveltejs/vite-plugin-svelte": "^7.3.0",
        "@tailwindcss/forms": "^0.5.7",
        "@types/better-sqlite3": "^7.6.13",
        "@types/node": "^22.19.13",
        "@types/uuid": "^10.0.0",
        "@typescript-eslint/eslint-plugin": "^8.67.0",
        "@typescript-eslint/parser": "^8.67.0",
        "@zerodevx/svelte-img": "^2.1.2",
        "autoprefixer": "^10.4.16",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-svelte": "^3.23.0",
        "eslint-plugin-unused-imports": "^4.2.0",
        "http-status-codes": "^2.3.0",
        "postcss": "^8.4.32",
        "prettier": "^3.1.0",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-svelte": "^4.1.1",
        "prisma": "^7.6.0",
        "svelte": "^5.0.0",
        "svelte-check": "^4.0.0",
        "svelte-loading-spinners": "^0.3.4",
        "sveltekit-sse": "^0.15.1",
        "tailwindcss": "^3.4.0",
